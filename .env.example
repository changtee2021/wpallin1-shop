UPSTASH_REDIS_REST_TOKEN=

# Smart product search + Room Advisor vision (optional — falls back without key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# E2E smoke tests (Playwright — never commit real passwords)
