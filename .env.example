# Email (server only — verify domain in Resend + set SPF/DKIM/DMARC)
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# Set to false to pause webhooks/email during migration
INTEGRATIONS_ENABLED=true

# Brand-site quote form: guest requests become draft quotations owned by this staff user (auth user id)
WEB_QUOTE_OWNER_USER_ID=
# LINE Messaging API push to the sales group/user (skipped when empty)
LINE_STAFF_CHANNEL_ACCESS_TOKEN=
LINE_STAFF_TARGET_ID=

# Rate limiting (optional — provision Upstash Redis via Vercel Marketplace)
